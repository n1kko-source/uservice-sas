{
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/nosotros", "destination": "/nosotros/index.html" },
    { "source": "/servicios", "destination": "/servicios/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    {
      "source": "/blog/cuanto-cuesta-software-a-medida",
      "destination": "/blog/cuanto-cuesta-software-a-medida/index.html"
    },
    {
      "source": "/blog/software-a-medida-vs-empaquetado",
      "destination": "/blog/software-a-medida-vs-empaquetado/index.html"
    },
    {
      "source": "/terminos-y-condiciones",
      "destination": "/terminos-y-condiciones/index.html"
    },
    {
      "source": "/servicios/desarrollo-web",
      "destination": "/servicios/desarrollo-web/index.html"
    },
    {
      "source": "/servicios/software-empresarial",
      "destination": "/servicios/software-empresarial/index.html"
    },
    {
      "source": "/servicios/aplicaciones-moviles",
      "destination": "/servicios/aplicaciones-moviles/index.html"
    },
    {
      "source": "/servicios/integraciones-apis",
      "destination": "/servicios/integraciones-apis/index.html"
    },
    {
      "source": "/servicios/cloud-devops",
      "destination": "/servicios/cloud-devops/index.html"
    },
    {
      "source": "/servicios/consultoria",
      "destination": "/servicios/consultoria/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/_shell.html"
    }
  ]
}
